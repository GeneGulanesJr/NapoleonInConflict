{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "lib": ["ES2022", "DOM"],
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "types": ["node"]
  },
  "include": ["src", "server", "scripts"]
}
